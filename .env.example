# Google OAuth 2.0 (Continue with Google)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google (and your production domain)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Real SMS Gateway for OTPs
# Option 1: Fast2SMS (Instant Indian carrier SMS - https://www.fast2sms.com)
FAST2SMS_API_KEY=""

# Option 2: Twilio (Global SMS delivery)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

