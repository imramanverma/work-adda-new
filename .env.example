# ==========================================
# Work Adda - Environment Variables
# ==========================================

# 1. Database Connection String
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Cloud Deployment (PostgreSQL - Neon, Supabase, Render, Railway, etc.):
# DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/workadda?sslmode=require"

# 2. JWT Authentication Secret
# Generate a strong 32+ character random string for production
JWT_SECRET="replace-with-a-very-strong-secret-key-for-production"

# 3. Application Domain URL
# Set this to your production domain (e.g. https://work-adda.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Optional Integrations (Mocked defaults provided)
PAYMENT_PROVIDER_KEY="wa_mock_key_2026"
PAYMENT_PROVIDER_SECRET="wa_mock_secret_2026"
EMAIL_PROVIDER_KEY="wa_mock_email_key_2026"
MAPS_API_KEY="wa_mock_maps_api_key"
