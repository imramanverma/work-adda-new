generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String    @unique
  passwordHash String
  role         String    // "WORKER", "EMPLOYER", "ADMIN"
  profileImage String?
  location     String?
  latitude     Float?
  longitude    Float?
  isVerified   Boolean   @default(false)
  phoneVerified Boolean  @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workerProfile           WorkerProfile?
  employerProfile         EmployerProfile?
  applications            Application[]
  assignmentsWorker       WorkAssignment[] @relation("WorkerAssignments")
  assignmentsEmployer     WorkAssignment[] @relation("EmployerAssignments")
  paymentsPaid            Payment[]        @relation("PayerPayments")
  paymentsReceived        Payment[]        @relation("ReceiverPayments")
  disputesRaised          Dispute[]        @relation("DisputesRaised")
  reviewsGiven            Review[]         @relation("ReviewsGiven")
  reviewsReceived         Review[]         @relation("ReviewsReceived")
  notifications           Notification[]
  reportsFiled            Report[]         @relation("ReportsFiled")
  reportsReceived         Report[]         @relation("ReportsReceived")
  messagesSent            Message[]
  conversationsAsWorker   Conversation[]   @relation("WorkerConversations")
  conversationsAsEmployer Conversation[]   @relation("EmployerConversations")

  @@index([role])
  @@index([email])
}

model WorkerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio               String?
  skills            String   @default("[]") // JSON string array of skills
  experience        String?
  education         String?
  availability      String?  @default("Flexible")
  preferredJobType  String?  @default("ANY")
  preferredDistance Int      @default(10) // km
  expectedPay       Float?
  rating            Float    @default(0.0)
  completedJobs     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EmployerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  businessType       String   @default("Local Business")
  shopImage          String?  // Shop / Storefront / Workplace Image
  description        String?
  address            String?
  location           String?
  latitude           Float?
  longitude          Float?
  website            String?
  verificationStatus String   @default("PENDING") // "PENDING", "VERIFIED", "REJECTED"
  rating             Float    @default(0.0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  jobs               Job[]
}

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  category String

  @@index([category])
}

model Job {
  id              String          @id @default(cuid())
  employerId      String
  employer        EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        String          // Retail, Delivery, Sales, Hospitality, Construction, Events, Office Assistance, Data Entry, IT & Technology, Repair & Maintenance, Education, Logistics, General Labour
  requiredSkills  String          @default("[]") // JSON string array
  jobType         String          // FULL_TIME, PART_TIME, TEMPORARY, GIG, FLEXIBLE, INTERNSHIP
  location        String
  latitude        Float?
  longitude       Float?
  payAmount       Float
  payType         String          // HOURLY, DAILY, FIXED, MONTHLY
  workersRequired Int             @default(1)
  deadline        DateTime?
  startDate       DateTime?
  endDate         DateTime?
  status          String          @default("OPEN") // OPEN, PAUSED, FILLED, COMPLETED, CANCELLED
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  applications    Application[]
  assignments     WorkAssignment[]
  conversations   Conversation[]
  reviews         Review[]
  reports         Report[]
  payments        Payment[]
  disputes        Dispute[]

  @@index([category])
  @@index([status])
  @@index([jobType])
  @@index([location])
}

model Application {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId     String
  worker       User     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  coverMessage String?
  proposedPay  Float?
  status       String   @default("PENDING") // PENDING, SHORTLISTED, ACCEPTED, REJECTED, WITHDRAWN
  appliedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([jobId, workerId])
  @@index([status])
}

model WorkAssignment {
  id               String   @id @default(cuid())
  jobId            String
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId         String
  worker           User     @relation("WorkerAssignments", fields: [workerId], references: [id], onDelete: Cascade)
  employerId       String
  employer         User     @relation("EmployerAssignments", fields: [employerId], references: [id], onDelete: Cascade)
  agreedAmount     Float
  startDate        DateTime?
  endDate          DateTime?
  status           String   @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, COMPLETED, APPROVED, PAYMENT_PENDING, PAID, CANCELLED
  completionStatus String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, SUBMITTED, APPROVED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payment          Payment?

  @@index([status])
}

model Payment {
  id                 String            @id @default(cuid())
  jobId              String
  job                Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  payerId            String
  payer              User              @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Cascade)
  receiverId         String
  receiver           User              @relation("ReceiverPayments", fields: [receiverId], references: [id], onDelete: Cascade)
  assignmentId       String?           @unique
  assignment         WorkAssignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  amount             Float             // Gross amount in INR
  currency           String            @default("INR")
  platformFee        Float             @default(0.0)
  workerAmount       Float             // Net amount allocated to worker
  razorpayOrderId    String?           @unique
  razorpayPaymentId  String?           @unique
  razorpaySignature  String?
  razorpayTransferId String?
  status             String            @default("CREATED") // CREATED, PAYMENT_PENDING, PAYMENT_PROCESSING, PAID, HELD, WORK_IN_PROGRESS, WORK_COMPLETED, RELEASE_PENDING, RELEASED, SETTLED, FAILED, CANCELLED, REFUND_PENDING, REFUNDED, DISPUTED
  escrowStatus       String            @default("PENDING") // PENDING, HELD, RELEASE_ELIGIBLE, RELEASED, REFUNDED, DISPUTED
  paymentMethod      String            @default("RAZORPAY") // RAZORPAY, UPI, NETBANKING, CARD
  transactionId      String            @unique @default(cuid()) // Internal transaction reference
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  paidAt             DateTime?
  heldAt             DateTime?
  releasedAt         DateTime?
  refundedAt         DateTime?
  failureReason      String?
  metadata           String?           // JSON string for extra audit info

  ledger             EscrowLedger?
  disputes           Dispute[]
  auditLogs          PaymentAuditLog[]

  @@index([status])
  @@index([escrowStatus])
  @@index([jobId])
  @@index([payerId])
  @@index([receiverId])
}

model EscrowLedger {
  id             String   @id @default(cuid())
  paymentId      String   @unique
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  jobAmount      Float
  platformFee    Float    @default(0.0)
  workerAmount   Float
  heldAmount     Float    @default(0.0)
  releasedAmount Float    @default(0.0)
  refundedAmount Float    @default(0.0)
  currency       String   @default("INR")
  isReconciled   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Dispute {
  id           String    @id @default(cuid())
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  paymentId    String
  payment      Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  raisedById   String
  raisedBy     User      @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  reason       String
  description  String
  evidence     String?
  status       String    @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, REJECTED
  resolution   String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([jobId])
  @@index([paymentId])
}

model PaymentAuditLog {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  jobId      String
  actorId    String?  // user ID or "SYSTEM" or "WEBHOOK"
  actorRole  String?  // "HIRER", "WORKER", "ADMIN", "SYSTEM", "WEBHOOK"
  eventType  String   // ORDER_CREATED, PAYMENT_INITIATED, PAYMENT_VERIFIED, ESCROW_HELD, WORK_STARTED, WORK_COMPLETED, RELEASE_INITIATED, RELEASE_COMPLETED, REFUND_INITIATED, REFUND_COMPLETED, DISPUTE_OPENED, DISPUTE_RESOLVED
  fromStatus String?
  toStatus   String?
  metadata   String?  // JSON string
  createdAt  DateTime @default(now())

  @@index([paymentId])
  @@index([jobId])
  @@index([eventType])
}

model Review {
  id             String   @id @default(cuid())
  reviewerId     String
  reviewer       User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUserId String
  reviewedUser   User     @relation("ReviewsReceived", fields: [reviewedUserId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rating         Int      // 1 to 5
  comment        String?
  createdAt      DateTime @default(now())

  @@unique([reviewerId, jobId])
  @@index([reviewedUserId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // APPLICATION, ASSIGNMENT, PAYMENT, REVIEW, MESSAGE, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Conversation {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId   String
  worker     User      @relation("WorkerConversations", fields: [workerId], references: [id], onDelete: Cascade)
  employerId String
  employer   User      @relation("EmployerConversations", fields: [employerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  messages   Message[]

  @@unique([jobId, workerId, employerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Report {
  id             String    @id @default(cuid())
  reporterId     String
  reporter       User      @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?     @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  jobId          String?
  job            Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  reason         String
  description    String
  status         String    @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt      DateTime  @default(now())

  @@index([status])
}

model OtpVerification {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  purpose   String   @default("REGISTER") // "REGISTER", "LOGIN", "PHONE_VERIFY"
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}
